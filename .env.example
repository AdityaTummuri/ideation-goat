# Copy to .env. Every variable is optional.

# Raises GitHub's limit from 60 to 5,000 requests an hour. Required only to build the index.
GITHUB_TOKEN=

# Optional LLM summaries. Without a key, a template summary is used.
# Free-tier prompts may be used by the provider; only public data is sent.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional; a free key gives Semantic Scholar 1 request/second instead of a shared pool.
SEMANTIC_SCHOLAR_API_KEY=

# Where the index, cache and embedding model live (default ~/.cache/ideation-goat)
# IDEATION_GOAT_HOME=
# check_dependencies only reads folders inside this root (default: working directory)
# IDEATION_GOAT_WORKSPACE=
