# Copy this file to '.env' and fill in the values you need.
# Every variable is optional: the core engine runs keyless with reduced rate limits.

# --- Vector database (ChromaDB) ---
CHROMA_PATH=./chroma_data
CHROMADB_COLLECTION=github_repos

# --- Security boundary for scaffolding writes and workspace scans (defaults to the repo root) ---
# WORKSPACE_ROOT=.

# --- LLM synthesis ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- GitHub (raises API rate limits) ---
GITHUB_TOKEN=your_github_personal_access_token_here

# --- Research & patents (arXiv and Semantic Scholar are keyless) ---
ARXIV_TIMEOUT=8
ARXIV_MAX_RESULTS=10
UNPAYWALL_EMAIL=your_email_for_unpaywall_here
GOOGLE_PATENTS_API_KEY=your_serpapi_key_here
GOOGLE_SCHOLAR_API_KEY=your_serpapi_key_here
