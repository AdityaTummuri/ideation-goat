# All integrations work without keys. Keys raise rate limits or enable optional sources.
# MCP clients usually pass these through the "env" block of their server config.

# Directory the server may read (workspace tools) and write (scaffold_project). Defaults to the process cwd.
WORKSPACE_ROOT=

# GitHub: 60 req/h anonymous -> 5,000 req/h with a token (no scopes needed for public repos)
GITHUB_TOKEN=

# GitLab (optional; public search works anonymously)
GITLAB_TOKEN=
GITLAB_API_BASE_URL=https://gitlab.com/api/v4

# Patent search (search_patents is disabled without this). https://serpapi.com
SERPAPI_API_KEY=

# Semantic Scholar API key (optional; anonymous requests share a global rate limit)
SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall open-access PDF lookup (optional; their terms require a contact email)
UNPAYWALL_EMAIL=

# HTTP transport only: bearer token; required when binding to a non-loopback host
MCP_AUTH_TOKEN=

# debug | info | warn | error  (logs go to stderr)
LOG_LEVEL=info
HTTP_TIMEOUT_MS=10000
